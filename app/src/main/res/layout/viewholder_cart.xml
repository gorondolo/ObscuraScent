<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#22223A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgCartItem"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvCartMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8888AA"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvCartNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8E8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvCartPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C8A96E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnIncrease"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="+"
                android:textColor="#C8A96E"
                android:textSize="18sp"
                android:gravity="center"
                android:background="#12121E"/>

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="1"
                android:textColor="#E8E8F0"
                android:textSize="14sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/btnDecrease"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="-"
                android:textColor="#C8A96E"
                android:textSize="18sp"
                android:gravity="center"
                android:background="#12121E"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>